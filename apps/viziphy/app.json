{
  "expo": {
    "name": "Viziphy",
    "slug": "viziphy",
    "scheme": "viziphy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.r2q2group.viziphy",
      "supportsTablet": false
    },
    "android": {
      "package": "com.r2q2group.viziphy",
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-asset",
      "./plugins/withKotlinGradlePluginVersion",
      "expo-font",
      "./plugins/withReleaseSigningConfig",
      "./plugins/withTargetSdk35"
    ]
  }
}
