# Copy to .env and fill in.
# Local dev against `supabase start` (see packages/backend/README.md):
# - Android emulator can't reach the host's 127.0.0.1 — use 10.0.2.2 instead,
#   the emulator's documented alias for the host loopback interface.
# - Physical device on the same network: use the host machine's LAN IP instead.
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
