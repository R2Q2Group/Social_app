# Copy to .env and run: supabase functions serve --env-file supabase/functions/.env
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically in production (supabase functions deploy) but must be set
# explicitly for local dev. Local defaults below match `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend free-tier key (near-zero cost model per RDD.md Section 5).
# In production set with: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=
